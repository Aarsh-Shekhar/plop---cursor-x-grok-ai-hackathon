# Copy to services/api/.env — never commit real keys.
# Grok is the primary provider when set (Cursor/Grok hackathon); Anthropic is the fallback.
XAI_API_KEY=
XAI_MODEL=grok-4
ANTHROPIC_API_KEY=
# Optional Modal GPU endpoint for true per-object meshes (MIDI-3D / TRELLIS class models)
MODAL_MIDI3D_URL=
# Hive agent service (vendor/hive)
HIVE_BACKEND_URL=http://localhost:8000
HIVE_FRONTEND_URL=http://localhost:3000
